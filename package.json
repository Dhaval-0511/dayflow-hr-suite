{
  "name": "dayflow-hrms",
  "version": "1.0.0",
  "description": "Dayflow - Human Resource Management System",
  "scripts": {
    "install:all": "cd server && npm install && cd ../client && npm install",
    "start": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "start:server": "cd server && node src/index.js",
    "start:client": "cd client && npx vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npx nodemon src/index.js",
    "dev:client": "cd client && npx vite",
    "db:migrate": "cd server && npx prisma migrate dev",
    "db:seed": "cd server && node prisma/seed.js",
    "db:studio": "cd server && npx prisma studio"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
